<UserControl x:Class="HipHipParquet.Controls.QualityGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="90">
    <Grid>
        <Canvas x:Name="GaugeCanvas" Width="140" Height="90"
                AutomationProperties.Name="Quality score gauge"/>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2">
            <TextBlock x:Name="ScoreText" 
                       FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Text="--"/>
            <TextBlock x:Name="GradeText" 
                       FontSize="10" 
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       Text=""/>
        </StackPanel>
    </Grid>
</UserControl>

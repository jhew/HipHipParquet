<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>


        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HipHipParquet</RootNamespace>

        <!-- App Options -->
        <UseRidGraph>true</UseRidGraph>
        <Platforms>x86;x64;ARM64</Platforms>

        <PublishProfile Condition="'$(Platform)' != 'AnyCPU'">win-$(Platform).pubxml</PublishProfile>
        <PublishProfile Condition="'$(Platform)' == 'AnyCPU'">win-x64.pubxml</PublishProfile>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) >= 8">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
        
        <!-- WPF Application -->
        <ApplicationIcon>Assets\app.ico</ApplicationIcon>

        <!-- Version — keep in sync with installer\HipHipParquet.iss MyAppVersion -->
        <Version>1.13.2</Version>
        <AssemblyVersion>1.13.2.0</AssemblyVersion>
        <FileVersion>1.13.2.0</FileVersion>

        <!-- NU1510 is a false positive: CodePages is required by FileFormatDetector for Windows-1252 support -->
        <NoWarn>$(NoWarn);NU1510</NoWarn>
    </PropertyGroup>



    <ItemGroup>
        <None Remove="HipHipParquet.slnx" />
    </ItemGroup>

    <!-- Exclude the test project from this build -->
    <ItemGroup>
        <Compile Remove="Tests\**" />
        <None Remove="Tests\**" />
        <Content Remove="Tests\**" />
        <EmbeddedResource Remove="Tests\**" />

        <Compile Remove="local-test-data\**" />
        <None Remove="local-test-data\**" />
        <Content Remove="local-test-data\**" />
        <EmbeddedResource Remove="local-test-data\**" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\app.png" />
        <Resource Include="Assets\app.ico" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shipped locally, never fetched: the app renders diagrams with no network access. -->
        <None Include="Assets\Markdown\mermaid.min.js">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- DuckDB for Parquet operations -->
        <PackageReference Include="DuckDB.NET.Data.Full" Version="1.1.3" />

        <!-- Required for CodePagesEncodingProvider / Encoding.GetEncoding(1252) -->
        <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />

        <!-- MVVM and UI helpers -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

        <!-- Markdown rendering for helper preview profiles -->
        <PackageReference Include="Markdig" Version="0.37.0" />

        <!-- Chromium preview host for the Markdown helper. Trident (WebBrowser) cannot
             run mermaid, and caps out below the CSS the preview stylesheet needs. -->
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
        
        <!-- Dependency injection and configuration -->
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    </ItemGroup>


</Project>

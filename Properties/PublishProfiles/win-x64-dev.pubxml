<?xml version="1.0" encoding="utf-8"?>
<!--
  Fast local-development publish profile.
  Framework-dependent: requires .NET 8 installed on the machine.
  No compression, no runtime bundling — typically completes in 2-4 s.
  Usage: dotnet publish -p:PublishProfile=win-x64-dev
-->
<Project>
  <PropertyGroup>
    <Configuration>Debug</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PublishDir>publish\win-x64-dev\</PublishDir>
  </PropertyGroup>
</Project>

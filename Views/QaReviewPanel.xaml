<UserControl x:Class="HipHipParquet.Views.QaReviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HipHipParquet.Controls"
             xmlns:vm="clr-namespace:HipHipParquet.ViewModels"
             xmlns:local="clr-namespace:HipHipParquet.Views"
             Background="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        
        <!-- Card style for sections -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        
        <!-- Score bar style -->
        <Style x:Key="ScoreBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="25"/>
            <Setter Property="Foreground" Value="#512BD4"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>

        <!-- Small badge style -->
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#512BD4" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🔍 QA Review" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Analyze" 
                            Command="{Binding AnalyzeCommand}" 
                            Background="White" Foreground="#512BD4" 
                            FontWeight="Bold" Padding="12,4" Margin="0,0,6,0"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Content="📄 Export" 
                            Command="{Binding ExportHtmlReportCommand}" 
                            Background="Transparent" Foreground="White" 
                            FontWeight="SemiBold" Padding="8,4"
                            BorderBrush="White" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Progress Bar -->
        <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="3"
                     Value="{Binding AnalysisProgress}" Maximum="100"
                     Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                     Foreground="#FFD700" Background="Transparent" BorderThickness="0"/>
        
        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
                
                <!-- Empty state -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock Text="📊" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="No analysis yet" FontSize="14" Foreground="Gray" 
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Load a parquet file and click Analyze" FontSize="11" Foreground="Gray"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Quality Score Gauge Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Data Quality Score" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        
                        <controls:QualityGaugeControl HorizontalAlignment="Center"
                            Score="{Binding OverallScore}"
                            Grade="{Binding OverallGrade}"/>
                        
                        <!-- Component scores -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <TextBlock FontSize="10" Foreground="Gray">
                                    <Run Text="Completeness"/>
                                    <Run Text="{Binding CompletenessScore, StringFormat={}{0:F1}/25, Mode=OneWay}"/>
                                </TextBlock>
                                <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding CompletenessScore}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                                <TextBlock FontSize="10" Foreground="Gray">
                                    <Run Text="Uniqueness"/>
                                    <Run Text="{Binding UniquenessScore, StringFormat={}{0:F1}/25, Mode=OneWay}"/>
                                </TextBlock>
                                <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding UniquenessScore}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock FontSize="10" Foreground="Gray">
                                    <Run Text="Validity"/>
                                    <Run Text="{Binding ValidityScore, StringFormat={}{0:F1}/25, Mode=OneWay}"/>
                                </TextBlock>
                                <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding ValidityScore}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock FontSize="10" Foreground="Gray">
                                    <Run Text="Distribution"/>
                                    <Run Text="{Binding DistributionScore, StringFormat={}{0:F1}/25, Mode=OneWay}"/>
                                </TextBlock>
                                <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding DistributionScore}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Scoring Key -->
                        <Border Background="#F5F5F5" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="📖 Scoring Key" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock FontSize="10" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,3">
                                    <Run Text="Each dimension is scored 0–25. Total score = sum of all four (0–100)." FontStyle="Italic"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Run FontWeight="SemiBold" Text="Completeness"/>
                                    <Run Text="— Measures how few null/missing values exist. 0% nulls = 25/25."/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Run FontWeight="SemiBold" Text="Uniqueness"/>
                                    <Run Text="— Measures value diversity. Higher distinct-value ratios score higher; constant columns score low."/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Run FontWeight="SemiBold" Text="Validity"/>
                                    <Run Text="— Measures type consistency and value correctness. Penalizes empty strings, non-nullable columns with nulls, and suspicious patterns."/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#555" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="Distribution"/>
                                    <Run Text="— Measures data spread. Penalizes high outlier rates, extreme skew, and single-value dominance."/>
                                </TextBlock>
                                <TextBlock FontSize="9" Foreground="#999" Margin="0,6,0,0">
                                    <Run Text="🟢 80–100 Good"/>
                                    <Run Text="  "/>
                                    <Run Text="🟡 60–79 Fair"/>
                                    <Run Text="  "/>
                                    <Run Text="🔴 &lt;60 Needs Review"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Findings / Narrative Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">
                            <Run Text="📋 Findings"/>
                            <Run Text="{Binding Findings.Count, StringFormat='({0})', Mode=OneWay}" Foreground="Gray"/>
                        </TextBlock>
                        
                        <ItemsControl ItemsSource="{Binding Findings}" MaxHeight="250">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="4"
                                            BorderThickness="0,0,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#666"
                                                       TextWrapping="Wrap" Margin="18,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- Filter / Query Builder -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🔎 Filter Columns" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding FilterableMetrics}" 
                                      SelectedItem="{Binding FilterColumn}"
                                      Width="100" Margin="0,0,4,0" FontSize="11"/>
                            <ComboBox SelectedItem="{Binding FilterOperator}" Width="45" Margin="0,0,4,0" FontSize="11">
                                <ComboBoxItem Content="&gt;"/>
                                <ComboBoxItem Content="&lt;"/>
                                <ComboBoxItem Content="="/>
                                <ComboBoxItem Content="&gt;="/>
                                <ComboBoxItem Content="&lt;="/>
                            </ComboBox>
                            <TextBox Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="55" Margin="0,0,4,0" FontSize="11"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="Go" Command="{Binding ApplyFilterCommand}" 
                                    Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="✕" Command="{Binding ClearFilterCommand}" 
                                    Padding="6,2" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Column Profiles Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">
                            <Run Text="📊 Column Profiles"/>
                            <Run Text="{Binding DisplayedColumns.Count, StringFormat='({0})', Mode=OneWay}" Foreground="Gray"/>
                        </TextBlock>
                        
                        <ItemsControl ItemsSource="{Binding DisplayedColumns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,0,8" Padding="10">
                                        <StackPanel>
                                            <!-- Column header -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock FontSize="10" Foreground="Gray">
                                                        <Run Text="{Binding DuckDbType, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold"
                                                               Text="{Binding Score.Total, StringFormat={}{0:F0}}"/>
                                                </Border>
                                            </Grid>
                                            
                                            <!-- Stats grid -->
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                                    <TextBlock Text="Nulls" FontSize="9" Foreground="Gray"/>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <Run Text="{Binding NullPercentage, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,4">
                                                    <TextBlock Text="Distinct" FontSize="9" Foreground="Gray"/>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                               Text="{Binding DistinctCount, StringFormat={}{0:N0}}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,0,4">
                                                    <TextBlock Text="Complete" FontSize="9" Foreground="Gray"/>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <Run Text="{Binding Completeness, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <!-- Numeric-specific row -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Min" FontSize="9" Foreground="Gray"/>
                                                    <TextBlock FontSize="11" Text="{Binding Min, StringFormat={}{0:G6}, TargetNullValue=—}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="Mean" FontSize="9" Foreground="Gray"/>
                                                    <TextBlock FontSize="11" Text="{Binding Mean, StringFormat={}{0:G6}, TargetNullValue=—}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="Max" FontSize="9" Foreground="Gray"/>
                                                    <TextBlock FontSize="11" Text="{Binding Max, StringFormat={}{0:G6}, TargetNullValue=—}"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Sparkline (numeric columns with histogram data) -->
                                            <controls:SparklineControl Buckets="{Binding Histogram}" 
                                                                       Margin="0,6,0,0"
                                                                       Height="30"/>
                                            
                                            <!-- Per-column quality dimension scores -->
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                    <TextBlock Text="C" FontSize="8" Foreground="Gray" HorizontalAlignment="Center" ToolTip="Completeness"/>
                                                    <ProgressBar Height="4" Maximum="25" Value="{Binding Score.Completeness}" Foreground="#4CAF50" Background="#E8E8E8"/>
                                                    <TextBlock Text="{Binding Score.Completeness, StringFormat={}{0:F0}}" FontSize="8" Foreground="Gray" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                    <TextBlock Text="U" FontSize="8" Foreground="Gray" HorizontalAlignment="Center" ToolTip="Uniqueness"/>
                                                    <ProgressBar Height="4" Maximum="25" Value="{Binding Score.Uniqueness}" Foreground="#2196F3" Background="#E8E8E8"/>
                                                    <TextBlock Text="{Binding Score.Uniqueness, StringFormat={}{0:F0}}" FontSize="8" Foreground="Gray" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="3,0,3,0">
                                                    <TextBlock Text="V" FontSize="8" Foreground="Gray" HorizontalAlignment="Center" ToolTip="Validity"/>
                                                    <ProgressBar Height="4" Maximum="25" Value="{Binding Score.Validity}" Foreground="#FF9800" Background="#E8E8E8"/>
                                                    <TextBlock Text="{Binding Score.Validity, StringFormat={}{0:F0}}" FontSize="8" Foreground="Gray" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="3,0,0,0">
                                                    <TextBlock Text="D" FontSize="8" Foreground="Gray" HorizontalAlignment="Center" ToolTip="Distribution"/>
                                                    <ProgressBar Height="4" Maximum="25" Value="{Binding Score.Distribution}" Foreground="#9C27B0" Background="#E8E8E8"/>
                                                    <TextBlock Text="{Binding Score.Distribution, StringFormat={}{0:F0}}" FontSize="8" Foreground="Gray" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Top values -->
                                            <ItemsControl ItemsSource="{Binding TopValues}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid>
                                                                <ProgressBar Value="{Binding Percentage}" Maximum="100"
                                                                             Height="16" Foreground="#E8EAF6" Background="#F5F5F5"
                                                                             BorderThickness="0"/>
                                                                <TextBlock Text="{Binding Value}" FontSize="9" Margin="4,0,0,0"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1" FontSize="9" Foreground="Gray"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <Run Text="{Binding Percentage, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- Dimension Group-By Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Toggle header -->
                        <Button Command="{Binding ToggleGroupByExpandedCommand}" 
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                Cursor="Hand" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📐 Group By Dimensions" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="#512BD4" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶ Expand"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroupByExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▼ Collapse"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                        
                        <!-- Expandable dimension picker -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGroupByExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="Select categorical columns to group by:" FontSize="10" Foreground="Gray" Margin="0,0,0,4"/>
                            
                            <ItemsControl ItemsSource="{Binding AvailableDimensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  FontSize="11" Margin="0,0,10,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="▶ Apply Group By" Command="{Binding ApplyGroupByCommand}"
                                        Padding="10,4" FontSize="11" HorizontalAlignment="Left"
                                        Background="#512BD4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="✕ Clear" Command="{Binding ClearGroupByCommand}"
                                        Padding="10,4" FontSize="11" Margin="8,0,0,0"
                                        Background="Transparent" Foreground="#999" BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"/>
                            </StackPanel>
                            
                            <!-- Status message -->
                            <TextBlock Text="{Binding GroupByStatusMessage}" FontSize="10" Foreground="#888" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <!-- Grouped Results (always visible when available, even when collapsed) -->
                        <ItemsControl ItemsSource="{Binding GroupedResults}" Margin="0,8,0,0"
                                      Visibility="{Binding HasGroupedResults, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding GroupKey}" FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="Gray" 
                                                       VerticalAlignment="Center" Margin="8,0">
                                                <Run Text="{Binding RowCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                <Run Text="rows"/>
                                            </TextBlock>
                                            <Border Grid.Column="2" CornerRadius="10" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold"
                                                           Text="{Binding QualityScore, StringFormat={}{0:F0}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- File Comparison Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🔄 File Comparison" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        
                        <Button Content="Compare with another file..." 
                                Command="{Binding CompareWithFileCommand}"
                                Padding="10,4" FontSize="11" HorizontalAlignment="Left"/>
                        
                        <!-- Comparison results -->
                        <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}"
                                    Margin="0,8,0,0">
                            <TextBlock FontSize="11" Margin="0,0,0,4">
                                <Run Text="Comparing with: " Foreground="Gray"/>
                                <Run Text="{Binding ComparisonFileName, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Baseline" FontSize="10" Foreground="Gray"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding Comparison.BaselineProfile.RowCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        <Run Text=" rows"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11">
                                        <Run Text="Score: "/>
                                        <Run Text="{Binding Comparison.BaselineProfile.OverallScore.Total, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Comparison" FontSize="10" Foreground="Gray"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding Comparison.ComparisonProfile.RowCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        <Run Text=" rows"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11">
                                        <Run Text="Score: "/>
                                        <Run Text="{Binding Comparison.ComparisonProfile.OverallScore.Total, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            
                            <TextBlock FontSize="11" Margin="0,6,0,0">
                                <Run Text="Row delta: " Foreground="Gray"/>
                                <Run Text="{Binding Comparison.RowCountDelta, StringFormat={}{0:+#,0;-#,0;0}, Mode=OneWay}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding Comparison.RowCountDeltaPercent, StringFormat={}{0:+0.0;-0.0;0.0}%, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            
                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                <Run Text="Schema changes: " Foreground="Gray"/>
                                <Run Text="{Binding Comparison.SchemaChanges.Count, Mode=OneWay}"/>
                            </TextBlock>
                            
                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                <Run Text="Drift score: " Foreground="Gray"/>
                                <Run Text="{Binding Comparison.DriftScore, StringFormat={}{0:F1}/100, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

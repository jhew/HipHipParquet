<Window x:Class="HipHipParquet.Views.FileImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import File"
        Width="820" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="700" MinHeight="560"
        Icon="/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Subtle}" BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Border x:Name="FormatBadge" DockPanel.Dock="Left" CornerRadius="4" Padding="10,4" Margin="0,0,12,0"
                        Background="{DynamicResource Brush.InfoBg}" VerticalAlignment="Center">
                    <TextBlock x:Name="FormatBadgeText" Text="CSV" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.InfoText}"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="Configure Import Settings" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FilePathText" Text="" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" 
                               TextTrimming="CharacterEllipsis" MaxWidth="550" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Main Content: Options + Preview ────────────────────────── -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Options Panel ─────────────────────────────────── -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <!-- CSV/TSV Settings (shown only for CSV/TSV) -->
                        <StackPanel x:Name="CsvSettingsPanel" Visibility="Visible">
                            <TextBlock Text="📝 Delimiter &amp; Format" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                            <TextBlock Text="Delimiter" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="DelimiterCombo" Margin="0,0,0,10" SelectedIndex="0"
                                      SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                <ComboBoxItem Content="Comma (,)" Tag=","/>
                                <ComboBoxItem Content="Tab (⇥)" Tag="tab"/>
                                <ComboBoxItem Content="Semicolon (;)" Tag=";"/>
                                <ComboBoxItem Content="Pipe (|)" Tag="|"/>
                                <ComboBoxItem Content="Space" Tag=" "/>
                            </ComboBox>

                            <TextBlock Text="Quote character" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="QuoteCharCombo" Margin="0,0,0,10" SelectedIndex="0"
                                      SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="Double quote (&quot;)" Tag="&quot;"/>
                                <ComboBoxItem Content="Single quote (')" Tag="'"/>
                                <ComboBoxItem Content="None" Tag=""/>
                            </ComboBox>

                            <CheckBox x:Name="HasHeaderCheckBox" Content="First row contains column names"
                                      IsChecked="True" Margin="0,0,0,10"
                                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

                            <TextBlock Text="Skip rows from top" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="SkipRowsTextBox" Width="60" Text="0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OnOptionChanged"/>
                                <TextBlock Text="rows" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                            </StackPanel>

                            <Separator Margin="0,4,0,12"/>

                            <TextBlock Text="🔤 Encoding" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox x:Name="EncodingCombo" Margin="0,0,0,10" SelectedIndex="0"
                                      SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                <ComboBoxItem Content="UTF-8" Tag="utf-8"/>
                                <ComboBoxItem Content="UTF-8 with BOM" Tag="utf-8-bom"/>
                                <ComboBoxItem Content="Latin-1 (ISO-8859-1)" Tag="latin1"/>
                                <ComboBoxItem Content="Windows-1252" Tag="windows-1252"/>
                                <ComboBoxItem Content="UTF-16" Tag="utf-16"/>
                            </ComboBox>

                            <Separator Margin="0,4,0,12"/>

                            <TextBlock Text="⚠️ Error Handling" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CsvIgnoreErrorsCheckBox" Content="Skip malformed rows on error"
                                      IsChecked="False" Margin="0,0,0,6"
                                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
                            <TextBlock Text="When enabled, rows that cannot be parsed will be silently skipped instead of causing the import to fail."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="20,0,0,10"/>

                            <TextBlock Text="Null padding" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <CheckBox x:Name="CsvNullPaddingCheckBox" Content="Pad missing columns with NULL"
                                      IsChecked="False" Margin="0,0,0,10"
                                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
                        </StackPanel>

                        <!-- JSON Settings (shown only for JSON) -->
                        <StackPanel x:Name="JsonSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="📄 JSON Format" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                            <TextBlock Text="Format" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="JsonFormatCombo" Margin="0,0,0,10" SelectedIndex="0"
                                      SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                <ComboBoxItem Content="Array of objects" Tag="array"/>
                                <ComboBoxItem Content="Newline-delimited (NDJSON)" Tag="newline_delimited"/>
                                <ComboBoxItem Content="Unstructured" Tag="unstructured"/>
                            </ComboBox>

                            <TextBlock Text="Records mode" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="JsonRecordsCombo" Margin="0,0,0,10" SelectedIndex="0"
                                      SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                <ComboBoxItem Content="True (each element is a row)" Tag="true"/>
                                <ComboBoxItem Content="False (columnar orientation)" Tag="false"/>
                            </ComboBox>

                            <Separator Margin="0,4,0,12"/>

                            <TextBlock Text="🔍 Schema Detection" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                            <CheckBox x:Name="JsonAutoDetectCheckBox" Content="Auto-detect column types"
                                      IsChecked="True" Margin="0,0,0,10"
                                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

                            <TextBlock Text="Max nesting depth" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="JsonMaxDepthTextBox" Width="60" Text="-1"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OnOptionChanged"/>
                                <TextBlock Text="-1 = unlimited" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="Sample size" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="JsonSampleSizeTextBox" Width="60" Text="-1"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OnOptionChanged"/>
                                <TextBlock Text="-1 = all rows" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                            </StackPanel>

                            <Separator Margin="0,4,0,12"/>

                            <TextBlock Text="📅 Date/Time Formats" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                            <TextBlock Text="Date format" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="JsonDateFormatCombo" Margin="0,0,0,10" SelectedIndex="0"
                                      SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                <ComboBoxItem Content="YYYY-MM-DD" Tag="%Y-%m-%d"/>
                                <ComboBoxItem Content="MM/DD/YYYY" Tag="%m/%d/%Y"/>
                                <ComboBoxItem Content="DD/MM/YYYY" Tag="%d/%m/%Y"/>
                            </ComboBox>

                            <TextBlock Text="Timestamp format" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="JsonTimestampFormatCombo" Margin="0,0,0,10" SelectedIndex="0"
                                      SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                <ComboBoxItem Content="ISO 8601" Tag="%Y-%m-%dT%H:%M:%S"/>
                                <ComboBoxItem Content="YYYY-MM-DD HH:MM:SS" Tag="%Y-%m-%d %H:%M:%S"/>
                            </ComboBox>

                            <Separator Margin="0,4,0,12"/>

                            <TextBlock Text="⚠️ Error Handling" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <CheckBox x:Name="JsonIgnoreErrorsCheckBox" Content="Skip malformed records on error"
                                      IsChecked="False" Margin="0,0,0,6"
                                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
                            <TextBlock Text="When enabled, malformed JSON records will be silently skipped."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="20,0,0,10"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Splitter ────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.BorderNeutral}"/>

            <!-- ── Right: Preview Panel ────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview header -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Pane}" BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻ Refresh" 
                                Padding="10,4" Click="OnRefreshClick" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="📋 Data Preview" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="PreviewStatusText" Text="Loading preview..." FontSize="11" 
                                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Preview data grid -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="PreviewGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="{DynamicResource Brush.RowAlt}"
                              FontSize="11"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"/>

                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Adjusting settings will update this preview..."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" FontStyle="Italic" FontSize="13"/>

                    <!-- Loading spinner for preview -->
                    <Border x:Name="PreviewLoading" Visibility="Collapsed" Background="{DynamicResource Brush.Overlay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="0,0,0,6"/>
                            <TextBlock Text="Reading file..." Foreground="{DynamicResource Brush.AccentText}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Error panel -->
                <Border x:Name="ErrorPanel" Grid.Row="2" Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.WarningBorder}" 
                        BorderThickness="0,1,0,0" Padding="12,10" Visibility="Collapsed">
                    <DockPanel>
                        <!-- Buttons anchored at bottom -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,0,0">
                            <Button x:Name="SuggestSkipErrorsButton" Content="Enable 'Skip errors' and retry"
                                    Padding="8,4" Background="{DynamicResource Brush.Warning}" Foreground="{DynamicResource Brush.OnAccent}" BorderThickness="0"
                                    Click="OnSuggestSkipErrors" Visibility="Collapsed" Margin="0,0,6,0"/>
                            <Button x:Name="SuggestEncodingButton" Content="Try Latin-1 encoding"
                                    Padding="8,4" Background="{DynamicResource Brush.Warning}" Foreground="{DynamicResource Brush.OnAccent}" BorderThickness="0"
                                    Click="OnSuggestEncoding" Visibility="Collapsed" Margin="0,0,6,0"/>
                            <Button Content="Dismiss" Padding="8,4" Click="OnDismissError"/>
                        </StackPanel>

                        <!-- Scrollable error content area -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="CopyErrorButton" DockPanel.Dock="Right" Content="📋 Copy" 
                                                    Padding="6,2" Background="Transparent" Foreground="{DynamicResource Brush.WarningText}" 
                                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.WarningEmphasis}" FontSize="10"
                                                    Click="OnCopyErrorClick" Margin="8,0,0,0"/>
                                            <TextBlock Text="Import Error" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" FontSize="12"/>
                                        </DockPanel>
                                        <TextBox x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.WarningDeep}" 
                                                 FontSize="11" Margin="0,4,0,0" IsReadOnly="True" Background="Transparent"
                                                 BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Hidden"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock x:Name="ErrorSuggestions" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource Brush.Earth}" Margin="24,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Footer: Action buttons ──────────────────────────────────── -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Reset to Defaults" Padding="12,6" Click="OnResetDefaultsClick"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Padding="12,6" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0"/>
                    <Button x:Name="ImportButton" Content="Import File" Padding="16,6"
                            Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.OnAccent}" FontWeight="SemiBold"
                            IsDefault="True" Click="OnImportClick"/>
                </StackPanel>
                <StackPanel/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

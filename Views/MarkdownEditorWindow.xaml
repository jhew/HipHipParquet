<Window x:Class="HipHipParquet.Views.MarkdownEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:HipHipParquet.Converters"
        Title="{Binding WindowTitle}"
        Width="1080" Height="760"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Icon="/Assets/app.ico">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C7D5E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#EEF3F8">
        <Border DockPanel.Dock="Top" Background="#1F3A5C" Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Click="OnNewClick" Content="New"/>
                    <Button Style="{StaticResource ToolButton}" Click="OnOpenClick" Content="Open..."/>
                    <Button Style="{StaticResource ToolButton}" Click="OnSaveClick" Content="Save"/>
                    <Button Style="{StaticResource ToolButton}" Click="OnSaveAsClick" Content="Save As..."/>
                    <Button Style="{StaticResource ToolButton}" Click="OnDockBackClick" Content="Dock back"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Markdown Helper" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Simple open/edit/save and preview for markdown files." FontSize="12" Foreground="#D8E4F0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="12,12,12,0" Padding="8,6" Background="#FFFFFF" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Copy path" Padding="8,4" Margin="8,0,0,0"
                        Background="#FFFFFF" BorderBrush="#C7D5E3" BorderThickness="1" Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="OnCopyPathClick"
                        Visibility="{Binding CurrentFilePath, Converter={StaticResource StringToVisibility}}"/>
                <TextBlock Text="{Binding CurrentFilePath, TargetNullValue=''}"
                           VerticalAlignment="Center"
                           Foreground="#5C6F82"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#D5DFEA" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewProfileLabel}" Foreground="#8A9BB0" FontSize="11"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsPreviewActive, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#5C6F82" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="EditorTabs" Margin="12" BorderBrush="#D5DFEA" BorderThickness="1" SelectionChanged="OnEditorTabSelectionChanged">
            <TabItem Header="Edit">
                <Grid Background="#FFFFFF">
                    <TextBox x:Name="EditorTextBox"
                             Text="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Padding="14"
                             BorderThickness="0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Preview">
                <Grid Background="#FFFFFF">
                    <WebBrowser x:Name="PreviewBrowser" Margin="0"/>
                </Grid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>

<Window x:Class="HipHipParquet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HipHipParquet.Views"
        Title="HipHipParquet — Data Quality Viewer" Height="700" Width="1400"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnFileDrop">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="Save"/>
        <KeyBinding Key="F1" Command="Help"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Save" Executed="OnSaveClick"/>
        <CommandBinding Command="Help" Executed="OnHelpClick"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Click="OnOpenFileClick">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="RecentFilesMenuItem" Header="_Recent Files">
                    <MenuItem Header="(No recent files)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="SaveMenuItem" Header="_Save" Click="OnSaveClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _As..." Click="OnSaveAsClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ExportAsMenuItem" Header="_Export As..." Click="OnExportAsClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ImportOptionsMenuItem" Header="_Import Options..." Click="OnImportOptionsClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="FlattenJsonMenuItem" Header="Flatten _Nested JSON..." Click="OnFlattenJsonClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Text="&#x1F4E6;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Schema Pane" Click="OnToggleSchemaPaneClick" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Toggle _Filter Row" Click="OnToggleFilterRowClick" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="ToggleQualityPanelMenuItem" Header="Toggle _Quality Review Panel" Click="OnToggleQualityPanelClick" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_Edit" SubmenuOpened="OnEditMenuOpened" SubmenuClosed="OnEditMenuClosed">
                <MenuItem Header="_Copy" Click="OnCopyClick" InputGestureText="Ctrl+C">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy as _CSV" Click="OnCopyAsCsvClick" InputGestureText="Ctrl+Alt+C"/>
                <MenuItem Header="Copy as _TSV" Click="OnCopyAsTsvClick" InputGestureText="Ctrl+Shift+C"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Click="OnKeyboardShortcutsClick" InputGestureText="F1">
                    <MenuItem.Icon>
                        <TextBlock Text="⌨" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Tips &amp; Tricks" Click="OnTipsAndTricksClick">
                    <MenuItem.Icon>
                        <TextBlock Text="💡" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_About HipHipParquet..." Click="OnAboutClick">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid x:Name="MainContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SchemaPaneColumn" Width="250" MinWidth="200"/>
                <ColumnDefinition x:Name="SchemaSplitterColumn" Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="QualitySplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="QualityPaneColumn" Width="420" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Schema Pane -->
            <Border x:Name="SchemaPane" Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel x:Name="SchemaPanel" Margin="12">
                        <TextBlock Text="Schema" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SchemaStatusText" 
                                  Text="No file loaded" 
                                  Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter x:Name="SchemaSplitter" Grid.Column="1" 
                         HorizontalAlignment="Stretch" 
                         Background="#E0E0E0"/>

            <!-- Data Grid Area -->
            <Grid Grid.Column="2">
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Foreground="Gray"/>
                    <TextBlock Text="Open a data file to get started" 
                              FontSize="18" 
                              Foreground="Gray"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center"/>
                    <Button Content="Browse Files" 
                           Background="#512BD4"
                           Foreground="White"
                           Margin="0,16,0,0"
                           Padding="16,8"
                           Click="OnOpenFileClick"/>
                </StackPanel>
                
                <!-- Data Grid -->
                <Grid x:Name="DataGridContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search Panel -->
                    <ScrollViewer x:Name="SearchPanelContainer"
                                 Grid.Row="0" 
                                 HorizontalScrollBarVisibility="Hidden" 
                                 VerticalScrollBarVisibility="Disabled"
                                 Margin="12,12,12,0">
                        <Border Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel x:Name="SearchPanel" 
                                       Orientation="Horizontal" 
                                       Margin="0"/>
                        </Border>
                    </ScrollViewer>
                    
                    <!-- Load More Banner -->
                    <Border x:Name="LoadMoreBanner" Grid.Row="1" 
                            Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="0,0,0,1"
                            Padding="8,6" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Load Next 50K" Padding="10,4" Margin="0,0,6,0"
                                        Click="OnLoadMoreClick" Background="#FF9800" Foreground="White"
                                        BorderThickness="0"/>
                                <Button Content="Load All" Padding="10,4"
                                        Click="OnLoadAllClick" Background="#E65100" Foreground="White"
                                        BorderThickness="0"/>
                            </StackPanel>
                            <TextBlock x:Name="LoadMoreText" VerticalAlignment="Center"
                                       Text="Showing 50,000 of X rows" Foreground="#E65100" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid x:Name="DataGrid" 
                             Grid.Row="2"
                             AutoGenerateColumns="False"
                             HeadersVisibility="All"
                             GridLinesVisibility="All"
                             AlternatingRowBackground="#F9F9F9"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="False"
                             SelectionMode="Extended"
                             SelectionUnit="CellOrRowHeader"
                             Margin="12,5,12,12"
                             ScrollViewer.ScrollChanged="OnDataGridScrollChanged"
                             CellEditEnding="OnCellEditEnding"
                             EnableRowVirtualization="True"
                             EnableColumnVirtualization="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="OnContextCopyClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📋" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy with Headers" Click="OnContextCopyWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📋" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Copy as CSV" Click="OnContextCopyAsCsvClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="," FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as CSV with Headers" Click="OnContextCopyAsCsvWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="," FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Copy Row(s)" Click="OnContextCopyRowsClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="➡️" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy Row(s) with Headers" Click="OnContextCopyRowsWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="➡️" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Copy Column(s)" Click="OnContextCopyColumnsClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⬇️" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy Column(s) with Headers" Click="OnContextCopyColumnsWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⬇️" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- Quality Panel Splitter -->
            <GridSplitter x:Name="QualitySplitter" Grid.Column="3" 
                         HorizontalAlignment="Stretch" 
                         Background="#E0E0E0"
                         Visibility="Visible"/>

            <!-- Quality Review Panel -->
            <views:QualityReviewPanel x:Name="QualityReviewPanel" Grid.Column="4" 
                                 Visibility="Visible"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#88FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" 
                                 Width="200" Height="6" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LoadingText" Text="Loading..." 
                               HorizontalAlignment="Center" FontSize="14" Foreground="#512BD4"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="FormatBadge" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                            Visibility="Collapsed" Background="#E3F2FD">
                        <TextBlock x:Name="FormatBadgeText" Text="" FontSize="11" 
                                   FontWeight="SemiBold" Foreground="#1565C0"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Ready"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍 Global Search:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="GlobalSearchBox" 
                            Width="200" 
                            TextChanged="OnGlobalSearchTextChanged"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
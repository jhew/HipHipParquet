<Window x:Class="HipHipParquet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:HipHipParquet.Views"
        xmlns:local="clr-namespace:HipHipParquet.Views"
        Title="HipHipParquet — Data Quality Viewer" Height="700" Width="1400"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnFileDrop">
    <Window.Resources>
        <Style x:Key="PaneChrome" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Pane}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>
        <Style x:Key="PaneSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo x:Name="MainTaskbarItemInfo"/>
    </Window.TaskbarItemInfo>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="Save"/>
        <KeyBinding Key="F1" Command="Help"/>
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{x:Static views:MainWindow.GoToRowCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static views:MainWindow.FocusSearchCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{x:Static views:MainWindow.ZoomInCommand}"/>
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{x:Static views:MainWindow.ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{x:Static views:MainWindow.ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{x:Static views:MainWindow.ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{x:Static views:MainWindow.ResetZoomCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{x:Static views:MainWindow.ResetZoomCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{x:Static views:MainWindow.UndoCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Save" Executed="OnSaveClick"/>
        <CommandBinding Command="Help" Executed="OnHelpClick"/>
        <CommandBinding Command="{x:Static views:MainWindow.GoToRowCommand}" Executed="OnGoToRowShortcut"/>
        <CommandBinding Command="{x:Static views:MainWindow.FocusSearchCommand}" Executed="OnFocusSearchShortcut"/>
        <CommandBinding Command="{x:Static views:MainWindow.ZoomInCommand}" Executed="OnZoomInShortcut"/>
        <CommandBinding Command="{x:Static views:MainWindow.ZoomOutCommand}" Executed="OnZoomOutShortcut"/>
        <CommandBinding Command="{x:Static views:MainWindow.ResetZoomCommand}" Executed="OnResetZoomShortcut"/>
        <CommandBinding Command="{x:Static views:MainWindow.UndoCommand}" Executed="OnUndoShortcut"/>
    </Window.CommandBindings>
    <Grid Background="{DynamicResource Brush.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Click="OnOpenFileClick">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE838;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open _Markdown Helper..." Click="OnOpenMarkdownHelperClick">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE70F;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="RecentFilesMenuItem" Header="_Recent Files">
                    <MenuItem Header="(No recent files)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="SaveMenuItem" Header="_Save" Click="OnSaveClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE74E;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _As..." Click="OnSaveAsClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE792;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ExportAsMenuItem" Header="_Export As..." Click="OnExportAsClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xEDE1;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ImportOptionsMenuItem" Header="_Import Options..." Click="OnImportOptionsClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE713;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="FlattenJsonMenuItem" Header="Flatten _Nested JSON..." Click="OnFlattenJsonClick" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE7B8;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ToggleDataViewMenuItem" Header="Toggle _Data View" Click="OnToggleDataViewClick" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="ToggleSchemaPaneMenuItem" Header="Toggle _Schema Pane" Click="OnToggleSchemaPaneClick" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="ToggleQualityPanelMenuItem" Header="Toggle _Quality Review Panel" Click="OnToggleQualityPanelClick" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="ToggleQueryHubMenuItem" Header="Toggle _Query Hub" Click="OnToggleQueryHubClick" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="ToggleMarkdownHelperMenuItem" Header="Toggle _Markdown Helper" Click="OnToggleMarkdownHelperClick" IsCheckable="True" IsChecked="False"/>
                <Separator/>
                <MenuItem Header="_Theme">
                    <MenuItem x:Name="ThemeSystemMenuItem" Header="_Use System Setting" IsCheckable="True" Click="OnThemeSystemClick"/>
                    <MenuItem x:Name="ThemeLightMenuItem" Header="_Light" IsCheckable="True" Click="OnThemeLightClick"/>
                    <MenuItem x:Name="ThemeDarkMenuItem" Header="_Dark" IsCheckable="True" Click="OnThemeDarkClick"/>
                </MenuItem>
                <MenuItem Header="_Zoom">
                    <MenuItem x:Name="ZoomInMenuItem" Header="Zoom _In" Click="OnZoomInClick" InputGestureText="Ctrl+="/>
                    <MenuItem x:Name="ZoomOutMenuItem" Header="Zoom _Out" Click="OnZoomOutClick" InputGestureText="Ctrl+-"/>
                    <MenuItem x:Name="ZoomResetMenuItem" Header="_Reset to 100%" Click="OnResetZoomClick" InputGestureText="Ctrl+0"/>
                    <Separator/>
                    <MenuItem Header="Tip: hold Ctrl and scroll the wheel to zoom" IsEnabled="False"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Workspace">
                <MenuItem Header="_Save Current View" Click="OnSaveCurrentViewClick"/>
                <MenuItem x:Name="SavedViewsMenuItem" Header="_Apply Saved View">
                    <MenuItem Header="(No saved views)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="_Clear Saved Views" Click="OnClearSavedViewsClick"/>
                <Separator/>
                <MenuItem Header="Save Workspace _Snapshot" Click="OnSaveWorkspaceSnapshotClick"/>
                <MenuItem Header="Restore Workspace S_napshot" Click="OnRestoreWorkspaceSnapshotClick"/>
            </MenuItem>
            <MenuItem Header="_Edit" SubmenuOpened="OnEditMenuOpened" SubmenuClosed="OnEditMenuClosed">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo" Click="OnUndoLastActionClick" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="EditDeleteRowsMenuItem" Header="_Delete Row(s)" Click="OnContextDeleteRowsClick" InputGestureText="Del"/>
                <MenuItem Header="Row _Actions">
                    <MenuItem x:Name="EditKeepSelectedRowsMenuItem" Header="Keep Only Selected Rows" Click="OnContextKeepSelectedRowsClick"/>
                    <MenuItem x:Name="EditDeleteUnselectedRowsMenuItem" Header="Delete Unselected Rows" Click="OnContextDeleteUnselectedRowsClick"/>
                    <MenuItem x:Name="EditDuplicateRowsMenuItem" Header="Duplicate Row(s)" Click="OnContextDuplicateRowsClick"/>
                    <MenuItem x:Name="EditInsertBlankAboveMenuItem" Header="Insert Blank Row Above" Click="OnContextInsertBlankRowAboveClick"/>
                    <MenuItem x:Name="EditInsertBlankBelowMenuItem" Header="Insert Blank Row Below" Click="OnContextInsertBlankRowBelowClick"/>
                    <MenuItem x:Name="EditDeleteDuplicateRowsMenuItem" Header="Delete Duplicate Rows..." Click="OnContextDeleteDuplicateRowsClick"/>
                    <Separator/>
                    <MenuItem Header="Tip: right-click the grid for row and cell actions" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Copy" Click="OnCopyClick" InputGestureText="Ctrl+C">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE8C8;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy as _CSV" Click="OnCopyAsCsvClick" InputGestureText="Ctrl+Alt+C"/>
                <MenuItem Header="Copy as _TSV" Click="OnCopyAsTsvClick" InputGestureText="Ctrl+Shift+C"/>
                <MenuItem Header="Copy as _Markdown Table" Click="OnCopyAsMarkdownClick"/>
                <Separator/>
                <MenuItem Header="Clear All _Filters" Click="OnClearAllFiltersClick">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE71C;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Click="OnKeyboardShortcutsClick" InputGestureText="F1">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE765;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Tips &amp; Tricks" Click="OnTipsAndTricksClick">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xEA80;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Check for _Updates..." Click="OnCheckForUpdatesClick">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xEDE1;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_About HipHipParquet..." Click="OnAboutClick">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuIconGlyph}" Text="&#xE946;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" PreviewMouseWheel="OnMainContentPreviewMouseWheel">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentZoomTransform" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SchemaPaneColumn" Width="250" MinWidth="200"/>
                <ColumnDefinition x:Name="SchemaSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="MainDataColumn" Width="*" MinWidth="520"/>
                <ColumnDefinition x:Name="QualitySplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="QualityPaneColumn" Width="420" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Schema Pane -->
            <Border x:Name="SchemaPane" Grid.Column="0" Margin="8,10,4,10" Style="{StaticResource PaneChrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="12,10,12,6">
                        <TextBlock Text="Schema Explorer" Style="{StaticResource PaneTitle}"/>
                        <TextBlock Text="Browse and search inferred column structure" Margin="0,2,0,8" Style="{StaticResource PaneSubtitle}"/>
                        <Grid>
                            <TextBox x:Name="SchemaSearchBox"
                                     Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnSchemaSearchTextChanged"
                                     ToolTip="Filter the column list by name or data type"
                                     AutomationProperties.Name="Filter columns"/>
                            <TextBlock Text="Filter columns..."
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontStyle="Italic"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SchemaSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="SchemaPanel" Margin="12">
                            <TextBlock Text="Schema" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SchemaStatusText" 
                                      Text="No file loaded" 
                                      Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="8,6">
                        <Button x:Name="CopySchemaButton" Content="📋 Copy Schema" 
                                Click="OnCopySchemaClick" HorizontalAlignment="Stretch"
                                Padding="6,4" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" Cursor="Hand"
                                IsEnabled="False"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter x:Name="SchemaSplitter" Grid.Column="1" 
                         HorizontalAlignment="Stretch" 
                         Margin="0,10,0,10"
                         Background="{DynamicResource Brush.Border}"/>

            <!-- Data Grid Area -->
            <Grid x:Name="CenterColumnGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" Grid.Row="0" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="Open a data file to get started" 
                              FontSize="18" 
                              Foreground="{DynamicResource Brush.TextMuted}"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center"/>
                    <Button Content="Browse Files" 
                           Background="{DynamicResource Brush.Accent}"
                           Foreground="{DynamicResource Brush.OnAccent}"
                           Margin="0,16,0,0"
                           Padding="16,8"
                           Click="OnOpenFileClick"/>
                </StackPanel>
                
                <GridSplitter x:Name="MarkdownHelperSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource Brush.Border}" Visibility="Collapsed"/>
                <Border x:Name="MarkdownHelperHost" Grid.Row="2" Margin="12,4,12,10" Style="{StaticResource PaneChrome}" Visibility="Collapsed" MinHeight="220">
                    <local:MarkdownHelperPanel x:Name="EmbeddedMarkdownHelper" PopOutRequested="OnMarkdownHelperPopOutRequested" FocusModeToggleRequested="OnMarkdownHelperFocusModeToggleRequested"/>
                </Border>

                <!-- Data Grid -->
                <Grid x:Name="DataGridContainer" Visibility="Collapsed" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                        <Border x:Name="NotebookHub"
                            Grid.Row="0"
                            Margin="12,12,12,0"
                            Padding="12"
                            Style="{StaticResource PaneChrome}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Query Hub" Style="{StaticResource PaneTitle}"/>
                                    <Button Content="▴"
                                            Width="24"
                                            Height="24"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            FontWeight="Bold"
                                            ToolTip="Collapse Query Hub"
                                            AutomationProperties.Name="Collapse Query Hub"
                                            Click="OnCollapseQueryHubClick"
                                            DockPanel.Dock="Right"/>
                                </DockPanel>
                                <TextBlock x:Name="NotebookSourceHintText"
                                           Margin="0,4,0,8"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="Open a source to start building local notebook steps."
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Sources" FontWeight="SemiBold"/>
                                <ListBox x:Name="NotebookSourcesList"
                                         Height="92"
                                         Margin="0,4,0,10"
                                         DisplayMemberPath="SourceLabel"
                                         SelectionChanged="OnNotebookSourceSelectionChanged"/>

                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Notebook Blocks" FontWeight="SemiBold"/>
                                    <Button x:Name="ClearNotebookBlocksButton"
                                            Content="Clear"
                                            Margin="8,0,0,0"
                                            Padding="6,1"
                                            FontSize="11"
                                            Click="OnClearNotebookBlocksClick"
                                            ToolTip="Clear all notebook blocks"
                                            DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ListBox x:Name="NotebookBlocksList"
                                         Height="122"
                                         Margin="0,4,0,0"
                                         SelectionChanged="OnNotebookBlockSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TimelineLabel}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TimelineLabel}"/>

                                                <Button Grid.Column="1"
                                                        Content="X"
                                                        Margin="8,0,0,0"
                                                        Padding="4,0"
                                                        MinWidth="20"
                                                        MinHeight="20"
                                                        Tag="{Binding}"
                                                        Click="OnRemoveNotebookBlockClick"
                                                        ToolTip="Remove this block"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <WrapPanel VerticalAlignment="Center">
                                    <Border x:Name="NotebookModeBadge"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            Background="{DynamicResource Brush.InfoBg}"
                                            Margin="0,0,8,0">
                                        <TextBlock x:Name="NotebookModeBadgeText"
                                                   Text="Ready"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.InfoText}"/>
                                    </Border>
                                    <TextBlock x:Name="NotebookActiveSourceText"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               Text="No active source"/>
                                </WrapPanel>

                                <TextBlock x:Name="NotebookQueryLabelText"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="Run local DuckDB SQL over any opened notebook source alias."/>

                                <TextBox x:Name="NotebookQueryTextBox"
                                         AutomationProperties.Name="DuckDB SQL query"
                                         Margin="0,6,0,8"
                                         Height="112"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         TextWrapping="NoWrap"/>

                                <Border Margin="0,2,0,8"
                                    Padding="10"
                                    Background="{DynamicResource Brush.Pane}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="RunNotebookQueryButton"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Content="Run Query"
                                        Padding="14,6"
                                        Margin="0,0,8,8"
                                        Click="OnRunNotebookQueryClick"/>

                                    <Button x:Name="MaterializeWorkingSetButton"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Content="Load as Working Set"
                                        Padding="14,6"
                                        Margin="0,0,8,8"
                                        Click="OnMaterializeWorkingSetClick"/>

                                    <Menu Grid.Row="0"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Margin="0,0,0,8">
                                        <MenuItem Header="Notebook Actions ▾"
                                              Padding="10,4"
                                              Background="{DynamicResource Brush.Card}"
                                              BorderBrush="{DynamicResource Brush.Border}"
                                              BorderThickness="1">
                                        <MenuItem x:Name="SaveNotebookQueryButton"
                                              Header="Save Current Query"
                                              Click="OnSaveNotebookQueryClick"/>
                                        <MenuItem x:Name="LoadSavedNotebookQueryButton"
                                              Header="Load Selected Saved Query"
                                              Click="OnLoadSavedNotebookQueryClick"/>
                                        <MenuItem x:Name="DeleteSavedNotebookQueryButton"
                                              Header="Delete Selected Saved Query"
                                              Click="OnDeleteSavedNotebookQueryClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="NotebookExportButton"
                                              Header="Export Current Scope..."
                                              Click="OnNotebookExportClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="NullEmptyCheckButton"
                                              Header="Run Null / Empty Check"
                                              Click="OnNotebookNullEmptyCheckClick"/>
                                        <MenuItem x:Name="DuplicateCheckButton"
                                              Header="Run Duplicate Check"
                                              Click="OnNotebookDuplicateCheckClick"/>
                                        <MenuItem x:Name="RegexCheckButton"
                                              Header="Run Regex Check"
                                              Click="OnNotebookRegexCheckClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="SaveSchemaTemplateButton"
                                              Header="Save Schema Template"
                                              Click="OnSaveSchemaTemplateClick"/>
                                        <MenuItem x:Name="ValidateSchemaTemplateButton"
                                              Header="Validate Selected Template"
                                              Click="OnValidateSchemaTemplateClick"/>
                                        </MenuItem>
                                    </Menu>

                                    <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Saved Query"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Margin="0,0,8,0"/>
                                        <ComboBox x:Name="SavedNotebookQueriesComboBox"
                                                  AutomationProperties.Name="Saved query"
                                              Width="250"
                                              Margin="0,0,16,0"
                                              DisplayMemberPath="Name"/>
                                        <TextBlock Text="Schema Template"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Margin="0,0,8,0"/>
                                        <ComboBox x:Name="SchemaTemplatesComboBox"
                                                  AutomationProperties.Name="Schema template"
                                              Width="250"
                                              DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    </Grid>
                                </Border>

                                <WrapPanel VerticalAlignment="Center">
                                    <Button x:Name="PreviewPreviousPageButton"
                                            Content="Previous Page"
                                            Padding="12,5"
                                            Margin="0,0,8,0"
                                            Click="OnPreviewPreviousPageClick"/>
                                    <Button x:Name="PreviewNextPageButton"
                                            Content="Next Page"
                                            Padding="12,5"
                                            Margin="0,0,12,0"
                                            Click="OnPreviewNextPageClick"/>
                                    <TextBlock x:Name="PreviewPageStatusText"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="Preview controls appear for large sources."/>
                                </WrapPanel>

                                <TextBlock x:Name="NotebookLastCheckText"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                        <Border x:Name="NotebookHubCollapsedBar"
                            Grid.Row="0"
                            Margin="12,12,12,0"
                            Padding="8,6"
                            Style="{StaticResource PaneChrome}"
                            Visibility="Collapsed">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Query Hub hidden"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <Button Content="▾ Expand Query Hub"
                                    Padding="10,3"
                                    Margin="10,0,0,0"
                                    Click="OnExpandQueryHubClick"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>
                    
                    <!-- Load More Banner -->
                    <Border x:Name="LoadMoreBanner" Grid.Row="1" 
                            Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.WarningBorder}" BorderThickness="0,0,0,1"
                            Padding="8,6" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Load Next 50K" Padding="10,4" Margin="0,0,6,0"
                                        Click="OnLoadMoreClick" Background="{DynamicResource Brush.Warning}" Foreground="{DynamicResource Brush.OnAccent}"
                                        BorderThickness="0"/>
                                <Button Content="Load All" Padding="10,4"
                                        Click="OnLoadAllClick" Background="{DynamicResource Brush.WarningEmphasis}" Foreground="{DynamicResource Brush.OnAccent}"
                                        BorderThickness="0"/>
                            </StackPanel>
                            <TextBlock x:Name="LoadMoreText" VerticalAlignment="Center"
                                       Text="Showing 50,000 of X rows" Foreground="{DynamicResource Brush.WarningText}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid x:Name="DataGrid" 
                             Grid.Row="2"
                             AutoGenerateColumns="False"
                             HeadersVisibility="All"
                             GridLinesVisibility="All"
                             AlternatingRowBackground="{DynamicResource Brush.RowAlt}"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="False"
                             SelectionMode="Extended"
                             SelectionUnit="CellOrRowHeader"
                             Margin="12,8,12,12"
                             CellEditEnding="OnCellEditEnding"
                             PreviewMouseRightButtonDown="OnDataGridPreviewMouseRightButtonDown"
                             EnableRowVirtualization="True"
                             EnableColumnVirtualization="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="DataGridContextMenu"
                                         Opened="OnDataGridContextMenuOpened"
                                         Closed="OnDataGridContextMenuClosed">
                                <MenuItem x:Name="UndoContextMenuItem" Header="Undo" Click="OnUndoLastActionClick"/>
                                <Separator/>
                                <MenuItem Header="Copy" Click="OnContextCopyClick">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuIconGlyph}" FontSize="12" Text="&#xE8C8;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy with Headers" Click="OnContextCopyWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuIconGlyph}" FontSize="12" Text="&#xE8C8;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Copy as CSV" Click="OnContextCopyAsCsvClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="," FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as CSV with Headers" Click="OnContextCopyAsCsvWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="," FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy as Markdown Table" Click="OnCopyAsMarkdownClick">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuIconGlyph}" FontSize="12" Text="&#xE70F;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Copy Row(s)" Click="OnContextCopyRowsClick">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuIconGlyph}" FontSize="12" Text="&#xE72A;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy Row(s) with Headers" Click="OnContextCopyRowsWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuIconGlyph}" FontSize="12" Text="&#xE72A;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CopyRowsAsCsvContextMenuItem" Header="Copy Row(s) as CSV" Click="OnContextCopyRowsAsCsvClick"/>
                                <MenuItem x:Name="CopyRowsAsJsonContextMenuItem" Header="Copy Row(s) as JSON" Click="OnContextCopyRowsAsJsonClick"/>
                                <Separator/>
                                <MenuItem x:Name="DeleteRowsContextMenuItem" Header="Delete Row(s)" Click="OnContextDeleteRowsClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="X" FontSize="12" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="KeepSelectedRowsContextMenuItem" Header="Keep Only Selected Rows" Click="OnContextKeepSelectedRowsClick"/>
                                <MenuItem x:Name="DeleteUnselectedRowsContextMenuItem" Header="Delete Unselected Rows" Click="OnContextDeleteUnselectedRowsClick"/>
                                <MenuItem x:Name="DuplicateRowsContextMenuItem" Header="Duplicate Row(s)" Click="OnContextDuplicateRowsClick"/>
                                <MenuItem x:Name="InsertBlankAboveContextMenuItem" Header="Insert Blank Row Above" Click="OnContextInsertBlankRowAboveClick"/>
                                <MenuItem x:Name="InsertBlankBelowContextMenuItem" Header="Insert Blank Row Below" Click="OnContextInsertBlankRowBelowClick"/>
                                <MenuItem x:Name="ExportSelectedRowsContextMenuItem" Header="Export Selected Rows..." Click="OnContextExportSelectedRowsClick"/>
                                <MenuItem x:Name="DeleteDuplicateRowsContextMenuItem" Header="Delete Duplicate Rows..." Click="OnContextDeleteDuplicateRowsClick"/>
                                <Separator/>
                                <MenuItem Header="Copy Column(s)" Click="OnContextCopyColumnsClick">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuIconGlyph}" FontSize="12" Text="&#xE74B;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy Column(s) with Headers" Click="OnContextCopyColumnsWithHeadersClick">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuIconGlyph}" FontSize="12" Text="&#xE74B;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="FilterToValueContextMenuItem" Header="Filter to This Value" Click="OnContextFilterToValueClick"/>
                                <MenuItem x:Name="ExcludeValueContextMenuItem" Header="Exclude This Value" Click="OnContextExcludeValueClick"/>
                                <MenuItem x:Name="ShowBlankValuesContextMenuItem" Header="Show Blank Values" Click="OnContextShowBlankValuesClick"/>
                                <Separator/>
                                <MenuItem x:Name="SetSelectedCellsToNullContextMenuItem" Header="Set Selected Cells to Null" Click="OnContextSetSelectedCellsToNullClick"/>
                                <MenuItem x:Name="FillDownContextMenuItem" Header="Fill Down" Click="OnContextFillDownClick"/>
                                <MenuItem x:Name="TrimWhitespaceContextMenuItem" Header="Trim Whitespace" Click="OnContextTrimWhitespaceClick"/>
                                <MenuItem x:Name="ReplaceSelectionContextMenuItem" Header="Replace in Selection..." Click="OnContextReplaceInSelectionClick"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- Quality Panel Splitter -->
            <GridSplitter x:Name="QualitySplitter" Grid.Column="3" 
                         HorizontalAlignment="Stretch" 
                         Margin="0,10,0,10"
                         Background="{DynamicResource Brush.Border}"
                         ShowsPreview="True"
                         ResizeBehavior="PreviousAndNext"
                         DragCompleted="OnQualitySplitterDragCompleted"
                         Visibility="Visible"/>

            <!-- Quality Review Panel -->
            <Border x:Name="QualityPanelShell" Grid.Column="4" Margin="4,10,8,10" Style="{StaticResource PaneChrome}" Padding="0">
                <views:QualityReviewPanel x:Name="QualityReviewPanel" Visibility="Visible"/>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource Brush.Overlay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" 
                                 Width="200" Height="6" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LoadingText" Text="Loading..." 
                               HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource Brush.AccentText}"/>
                    <Button x:Name="LoadingCancelButton" Content="Cancel" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Padding="18,4" Cursor="Hand"
                            Click="OnCancelLoadingClick"
                            AutomationProperties.Name="Cancel the operation in progress"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="FormatBadge" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                            Visibility="Collapsed" Background="{DynamicResource Brush.InfoBg}">
                        <TextBlock x:Name="FormatBadgeText" Text="" FontSize="11" 
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.InfoText}"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Ready"/>
                    <TextBlock x:Name="RowCountText" Text="" Margin="12,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ZoomBadge" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                            Visibility="Collapsed" Background="{DynamicResource Brush.InfoBg}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ZoomBadgeText" Text="" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.InfoText}" VerticalAlignment="Center"/>
                            <Button Content="✕" FontSize="10"
                                    Padding="4,0" Margin="6,0,0,0" BorderThickness="0"
                                    Background="Transparent" Foreground="{DynamicResource Brush.InfoText}" Cursor="Hand"
                                    ToolTip="Reset zoom to 100% (Ctrl+0)" Click="OnResetZoomClick"
                                    AutomationProperties.Name="Reset zoom to 100 percent"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FilterBadge" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                            Visibility="Collapsed" Background="{DynamicResource Brush.WarningBg}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FilterBadgeText" Text="" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Center"/>
                            <Button x:Name="ClearAllFiltersButton" Content="✕" FontSize="10"
                                    Padding="4,0" Margin="6,0,0,0" BorderThickness="0"
                                    Background="Transparent" Foreground="{DynamicResource Brush.WarningText}" Cursor="Hand"
                                    ToolTip="Clear all filters" Click="OnClearAllFiltersClick"
                                    AutomationProperties.Name="Clear all filters"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                            <Border x:Name="PendingChangesBadge" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                Visibility="Collapsed" Background="{DynamicResource Brush.DangerBg}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PendingChangesText" Text="" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Center"/>
                                <Button Content="Save" FontSize="10"
                                    Padding="4,0" Margin="6,0,0,0" BorderThickness="0"
                                    Background="Transparent" Foreground="{DynamicResource Brush.DangerText}" Cursor="Hand"
                                    ToolTip="Save pending changes" Click="OnSaveClick"
                                    AutomationProperties.Name="Save pending changes"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            </Border>
                    <Border x:Name="UndoActionBadge" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                            Visibility="Collapsed" Background="{DynamicResource Brush.SuccessBg}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UndoActionText" Text="" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Center"/>
                            <Button Content="Undo" FontSize="10"
                                    Padding="4,0" Margin="6,0,0,0" BorderThickness="0"
                                    Background="Transparent" Foreground="{DynamicResource Brush.SuccessText}" Cursor="Hand"
                                    ToolTip="Undo the last edit" Click="OnUndoLastActionClick"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="QualityStaleBadge" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                            Visibility="Collapsed" Background="{DynamicResource Brush.WarningBg}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Quality review is stale" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Center"/>
                            <Button Content="Refresh" FontSize="10"
                                    Padding="4,0" Margin="6,0,0,0" BorderThickness="0"
                                    Background="Transparent" Foreground="{DynamicResource Brush.WarningText}" Cursor="Hand"
                                    ToolTip="Refresh the quality review" Click="OnRefreshQualityReviewClick"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Global Search:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="GlobalSearchBox" 
                            Width="200" 
                            TextChanged="OnGlobalSearchTextChanged"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Global search"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

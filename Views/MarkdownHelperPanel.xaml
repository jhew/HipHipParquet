<UserControl x:Class="HipHipParquet.Views.MarkdownHelperPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:HipHipParquet.Converters"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Background="{DynamicResource Brush.Window}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MarkdownStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:MarkdownProfileNameConverter x:Key="ProfileName"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource Brush.Window}">
        <Border DockPanel.Dock="Top" Style="{StaticResource MarkdownHeaderBar}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource MarkdownHeaderSubtitle}"/>
                    <ComboBox x:Name="ProfileSelector" Width="150" Margin="0,0,10,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              Foreground="{DynamicResource Brush.TextPrimary}"
                              ToolTip="How permissive the preview renderer is"
                              AutomationProperties.Name="Markdown preview profile">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ProfileName}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource MarkdownToolButton}" Click="OnNewClick" Content="New"/>
                    <Button Style="{StaticResource MarkdownToolButton}" Click="OnOpenClick" Content="Open..."/>
                    <Button Style="{StaticResource MarkdownToolButton}" Click="OnSaveClick" Content="Save"/>
                    <Button Style="{StaticResource MarkdownToolButton}" Click="OnSaveAsClick" Content="Save As..."/>
                    <Button Style="{StaticResource MarkdownToolButton}" Click="OnFocusModeClick" Content="{Binding FocusModeButtonLabel}"/>
                    <Button Style="{StaticResource MarkdownToolButton}" Margin="0" Click="OnPopOutClick" Content="Pop out"
                            ToolTip="Move the helper into its own window"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Markdown Helper" Style="{StaticResource MarkdownHeaderTitle}"/>
                    <TextBlock Text="{Binding CurrentFilePath, TargetNullValue='No file open'}"
                               Style="{StaticResource MarkdownHeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Brush.Card}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewProfileLabel}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsPreviewActive, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="EditorTabs" Margin="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" SelectionChanged="OnEditorTabSelectionChanged">
            <TabItem Header="Edit">
                <Grid Background="{DynamicResource Brush.Card}">
                    <TextBox x:Name="EditorTextBox"
                             Text="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Padding="14"
                             BorderThickness="0"
                             Background="{DynamicResource Brush.Card}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             CaretBrush="{DynamicResource Brush.TextPrimary}"
                             AutomationProperties.Name="Markdown source"/>
                </Grid>
            </TabItem>
            <TabItem Header="Preview">
                <Grid Background="{DynamicResource Brush.Card}">
                    <wv2:WebView2 x:Name="PreviewBrowser" Margin="0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

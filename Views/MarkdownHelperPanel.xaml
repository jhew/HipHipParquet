<UserControl x:Class="HipHipParquet.Views.MarkdownHelperPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#EEF3F8">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel Background="#EEF3F8">
        <Border DockPanel.Dock="Top" Background="#F8FBFF" Padding="12" BorderBrush="#D5DFEA" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Padding="10,4" Click="OnNewClick" Content="New"/>
                    <Button Margin="0,0,8,0" Padding="10,4" Click="OnOpenClick" Content="Open..."/>
                    <Button Margin="0,0,8,0" Padding="10,4" Click="OnSaveClick" Content="Save"/>
                    <Button Margin="0,0,8,0" Padding="10,4" Click="OnSaveAsClick" Content="Save As..."/>
                    <Button Margin="0,0,8,0" Padding="10,4" Click="OnFocusModeClick" Content="{Binding FocusModeButtonLabel}"/>
                    <Button Padding="10,4" Click="OnPopOutClick" Content="Pop out"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Markdown Helper" FontSize="16" FontWeight="Bold" Foreground="#1F2D3D"/>
                    <TextBlock Text="Edit and preview markdown files." FontSize="12" Foreground="#5C6F82"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="#D5DFEA" BorderThickness="0,1,0,0" Background="White">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewProfileLabel}" Foreground="#8A9BB0" FontSize="11"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsPreviewActive, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#5C6F82" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="EditorTabs" Margin="8" SelectionChanged="OnEditorTabSelectionChanged">
            <TabItem Header="Edit">
                <TextBox x:Name="EditorTextBox" Text="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
            <TabItem Header="Preview"><WebBrowser x:Name="PreviewBrowser"/></TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

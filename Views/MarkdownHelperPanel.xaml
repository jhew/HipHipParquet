<UserControl x:Class="HipHipParquet.Views.MarkdownHelperPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#EEF3F8">
    <DockPanel Background="#EEF3F8">
        <Border DockPanel.Dock="Top" Background="#F8FBFF" Padding="12" BorderBrush="#D5DFEA" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Margin="0,0,8,0" Padding="10,5" Click="OnNewClick" Content="New"/>
                    <Button Margin="0,0,8,0" Padding="10,5" Click="OnOpenClick" Content="Open..."/>
                    <Button Margin="0,0,8,0" Padding="10,5" Click="OnSaveClick" Content="Save"/>
                    <Button Margin="0,0,8,0" Padding="10,5" Click="OnSaveAsClick" Content="Save As..."/>
                    <Button Padding="10,5" Click="OnPopOutClick" Content="Pop out"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Markdown Helper" FontSize="16" FontWeight="Bold" Foreground="#1F2D3D"/>
                    <TextBlock Text="Edit and preview markdown files." FontSize="12" Foreground="#5C6F82"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="EditorTabs" Margin="8" SelectionChanged="OnEditorTabSelectionChanged">
            <TabItem Header="Edit">
                <TextBox x:Name="EditorTextBox" Text="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
            <TabItem Header="Preview"><WebBrowser x:Name="PreviewBrowser"/></TabItem>
        </TabControl>
        <Border DockPanel.Dock="Bottom" Padding="10" BorderBrush="#D5DFEA" BorderThickness="1,1,1,0" Background="White"><TextBlock Text="{Binding StatusMessage}"/></Border>
    </DockPanel>
</UserControl>

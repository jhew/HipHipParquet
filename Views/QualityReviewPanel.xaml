<UserControl x:Class="HipHipParquet.Views.QualityReviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HipHipParquet.Controls"
             xmlns:vm="clr-namespace:HipHipParquet.ViewModels"
             xmlns:local="clr-namespace:HipHipParquet.Views"
             xmlns:conv="clr-namespace:HipHipParquet.Converters"
             Background="{DynamicResource Brush.Pane}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <conv:SortIndicatorConverter x:Key="SortIndicatorConverter"/>
        
        <!-- Card style for sections -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        
        <!-- Score bar style - default (Completeness) -->
        <Style x:Key="ScoreBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="25"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Subtle}"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>
        
        <!-- Score bar colors for each dimension -->
        <Style x:Key="CompletenessBar" TargetType="ProgressBar" BasedOn="{StaticResource ScoreBar}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
        </Style>
        <Style x:Key="UniquenessBar" TargetType="ProgressBar" BasedOn="{StaticResource ScoreBar}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
        </Style>
        <Style x:Key="ValidityBar" TargetType="ProgressBar" BasedOn="{StaticResource ScoreBar}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
        </Style>
        <Style x:Key="DistributionBar" TargetType="ProgressBar" BasedOn="{StaticResource ScoreBar}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Special}"/>
        </Style>

        <!-- Small badge style -->
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Selectable text style: TextBox that looks and behaves like a TextBlock -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      Background="Transparent"
                                      Padding="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Export button style - matches Analyze button colors -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Subtle}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BorderNeutral}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.Subtle}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Padding="12,10" Background="{DynamicResource Brush.Pane}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Quality Review" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.WarningBg}" CornerRadius="12" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsProfileStale, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Refresh recommended" FontSize="10" Foreground="{DynamicResource Brush.WarningText}" FontWeight="SemiBold"/>
                            <Button Content="Refresh"
                                    Command="{Binding AnalyzeCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource Brush.WarningText}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="6,0,0,0"
                                    FontSize="10"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                        <Button Content="Analyze" 
                            Command="{Binding AnalyzeCommand}" 
                            Background="{DynamicResource Brush.Card}" Foreground="{DynamicResource Brush.HeadingText}" 
                            FontWeight="Bold" Padding="12,4" Margin="0,0,6,0"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Cursor="Hand"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource InverseBoolToVis}}"/>
                    <Button Content="⏹ Cancel"
                            Command="{Binding CancelAnalysisCommand}"
                            Background="{DynamicResource Brush.DangerEmphasis}" Foreground="{DynamicResource Brush.OnAccent}"
                            FontWeight="Bold" Padding="12,4" Margin="0,0,6,0"
                            BorderThickness="0" Cursor="Hand"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="📄 Export" 
                            Command="{Binding ExportHtmlReportCommand}"
                            Style="{StaticResource ExportButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Progress Bar -->
        <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="3"
                     Value="{Binding AnalysisProgress}" Maximum="100"
                     Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                 Foreground="{DynamicResource Brush.HeadingText}" Background="Transparent" BorderThickness="0"/>
        
        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
                
                <!-- Empty state -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock FontSize="36" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="📂"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFile}" Value="True">
                                            <Setter Property="Text" Value="🔍"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="No data set loaded"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFile}" Value="True">
                                            <Setter Property="Text" Value="Ready to analyze"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Open a data set to begin"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFile}" Value="True">
                                            <Setter Property="Text" Value="Click Analyze to profile the current set"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- File Summary Section -->
                <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="File Summary" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                        <!-- File name + analyzed at -->
                        <TextBox Style="{StaticResource SelectableText}" FontSize="11" FontWeight="SemiBold"
                                 Text="{Binding ProfileDisplayName, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBox Style="{StaticResource SelectableText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                 Text="{Binding AnalyzedAtDisplay, Mode=OneWay}" Margin="0,0,0,10"/>
                        <TextBox Style="{StaticResource SelectableText}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}"
                                 Text="{Binding SourceSetSummary, Mode=OneWay}"
                                 Margin="0,0,0,10"
                                 Visibility="{Binding HasSourceManifest, Converter={StaticResource BoolToVis}}"/>

                        <!-- Stat tiles: 3-column grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Rows -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Brush.Subtle}" CornerRadius="4" Padding="8,6" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="14" FontWeight="Bold"
                                             Text="{Binding FileProfile.RowCount, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                    <TextBlock Text="Rows" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Columns -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Brush.Subtle}" CornerRadius="4" Padding="8,6" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="14" FontWeight="Bold"
                                             Text="{Binding FileProfile.ColumnCount, Mode=OneWay}"/>
                                    <TextBlock Text="Columns" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- File Size -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource Brush.Subtle}" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="14" FontWeight="Bold"
                                             Text="{Binding FileProfile.FileSizeFormatted, Mode=OneWay}"/>
                                    <TextBlock Text="File Size" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Format -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Brush.Subtle}" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="14" FontWeight="Bold"
                                             Text="{Binding FormatDisplay, Mode=OneWay}"/>
                                    <TextBlock Text="Format" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Completeness -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Subtle}" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="14" FontWeight="Bold"
                                             Text="{Binding FileProfile.OverallCompleteness, StringFormat='{}{0:F1}%', Mode=OneWay}"/>
                                    <TextBlock Text="Completeness" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Columns with Nulls -->
                            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource Brush.Subtle}" CornerRadius="4" Padding="8,6" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="14" FontWeight="Bold"
                                             Text="{Binding FileProfile.ColumnsWithNulls, Mode=OneWay}"/>
                                    <TextBlock Text="Cols w/ Nulls" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Expander Header="Source Files"
                                  Margin="0,12,0,0"
                                  IsExpanded="False"
                                  Visibility="{Binding HasSourceManifest, Converter={StaticResource BoolToVis}}">
                            <Border Background="{DynamicResource Brush.Pane}" BorderBrush="{DynamicResource Brush.Subtle}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                <ListBox ItemsSource="{Binding SourceManifest}"
                                         MaxHeight="300"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True" Margin="0,2,0,2">
                                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10"
                                                           Text="{Binding RowCount, StringFormat='{}{0:N0} rows'}"/>
                                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" Margin="0,0,8,0"
                                                           Text="{Binding ContributionPercent, StringFormat='({0:F1}%)'}"/>
                                                <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding FileName}" ToolTip="{Binding FilePath}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SectionCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasProfile}" Value="True"/>
                                        <Condition Binding="{Binding IsEmptyProfile}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="No Data To Score" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding EmptyProfileMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Quality Score Gauge Section -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SectionCard}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProfile}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEmptyProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Data Quality Score" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        
                        <!-- Gauge + bars side by side -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MaxWidth="320"/>
                            </Grid.ColumnDefinitions>

                            <controls:QualityGaugeControl Grid.Column="0"
                                VerticalAlignment="Center" Margin="0,0,16,0"
                                Score="{Binding OverallScore}"
                                Grade="{Binding OverallGrade}"/>

                            <!-- Component scores with color-coded bars -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                             Text="{Binding CompletenessScore, StringFormat='Completeness {0:F1}/25', Mode=OneWay}"/>
                                    <ProgressBar Style="{StaticResource CompletenessBar}" Value="{Binding CompletenessScore}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                             Text="{Binding UniquenessScore, StringFormat='Uniqueness {0:F1}/25', Mode=OneWay}"/>
                                    <ProgressBar Style="{StaticResource UniquenessBar}" Value="{Binding UniquenessScore}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                             Text="{Binding ValidityScore, StringFormat='Validity {0:F1}/25', Mode=OneWay}"/>
                                    <ProgressBar Style="{StaticResource ValidityBar}" Value="{Binding ValidityScore}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                             Text="{Binding DistributionScore, StringFormat='Distribution {0:F1}/25', Mode=OneWay}"/>
                                    <ProgressBar Style="{StaticResource DistributionBar}" Value="{Binding DistributionScore}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        
                        <!-- Scoring Key - 2 column grid layout -->
                        <Border Background="{DynamicResource Brush.Subtle}" CornerRadius="8" Padding="16" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="📖 Scoring Key" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBox Style="{StaticResource SelectableText}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                                         Text="Each dimension is scored 0–25. Total score = sum of all four (0–100)."
                                         FontStyle="Italic"/>
                                
                                <!-- 2-column grid of dimensions -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Completeness -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Completeness" FontWeight="600" FontSize="10" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                                                 Text="Measures how few null/missing values exist. 0% nulls = 25/25."/>
                                    </StackPanel>
                                    
                                    <!-- Uniqueness -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Info}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Uniqueness" FontWeight="600" FontSize="10" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                                                 Text="Measures value diversity. Higher distinct-value ratios score higher; constant columns score low."/>
                                    </StackPanel>
                                    
                                    <!-- Validity -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Validity" FontWeight="600" FontSize="10" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                                                 Text="Measures type consistency and value correctness. Penalizes empty strings and suspicious patterns."/>
                                    </StackPanel>
                                    
                                    <!-- Distribution -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Special}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Distribution" FontWeight="600" FontSize="10" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                                                 Text="Measures data spread. Penalizes high outlier rates, extreme skew, and single-value dominance."/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Grade badges -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}" BorderThickness="1" CornerRadius="14" Padding="10,3" Margin="0,0,6,0">
                                        <TextBlock FontSize="9" FontWeight="500" Foreground="{DynamicResource Brush.SuccessText}">🟢 80–100 Good</TextBlock>
                                    </Border>
                                    <Border Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.WarningBorderSoft}" BorderThickness="1" CornerRadius="14" Padding="10,3" Margin="0,0,6,0">
                                        <TextBlock FontSize="9" FontWeight="500" Foreground="{DynamicResource Brush.WarningText}">🟡 60–79 Fair</TextBlock>
                                    </Border>
                                    <Border Background="{DynamicResource Brush.DangerBg}" BorderBrush="{DynamicResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="14" Padding="10,3">
                                        <TextBlock FontSize="9" FontWeight="500" Foreground="{DynamicResource Brush.DangerText}">🔴 &lt;60 Needs Review</TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Findings / Narrative Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">
                            <Run Text="📋 Findings"/>
                            <Run Text="{Binding Findings.Count, StringFormat='({0})', Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </TextBlock>
                        
                        <!-- Severity filter chips -->
                        <WrapPanel Margin="0,0,0,8">
                            <Button Command="{Binding SetFindingFilterCommand}" CommandParameter="All"
                                    Padding="8,3" Margin="0,0,4,4" FontSize="10" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFindingFilter}" Value="All">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock>
                                    <Run Text="All"/>
                                    <Run Text="{Binding Findings.Count, StringFormat=' ({0})', Mode=OneWay}"/>
                                </TextBlock>
                            </Button>
                            
                            <Button Command="{Binding SetFindingFilterCommand}" CommandParameter="Critical"
                                    Padding="8,3" Margin="0,0,4,4" FontSize="10" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFindingFilter}" Value="Critical">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Needs Review"/>
                                        <Run Text="{Binding FindingsCriticalCount, StringFormat=' ({0})', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SetFindingFilterCommand}" CommandParameter="Warning"
                                    Padding="8,3" Margin="0,0,4,4" FontSize="10" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFindingFilter}" Value="Warning">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Warning}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Fair"/>
                                        <Run Text="{Binding FindingsWarningCount, StringFormat=' ({0})', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SetFindingFilterCommand}" CommandParameter="Info"
                                    Padding="8,3" Margin="0,0,4,4" FontSize="10" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFindingFilter}" Value="Info">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Good"/>
                                        <Run Text="{Binding FindingsInfoCount, StringFormat=' ({0})', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        
                        <!-- Scrollable grouped findings -->
                        <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GroupedFindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,4">
                                            <!-- Group header (toggle) -->
                                            <ToggleButton IsChecked="{Binding IsExpanded}"
                                                          Background="Transparent" BorderThickness="0"
                                                          HorizontalContentAlignment="Stretch"
                                                          Cursor="Hand" Padding="4,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,5,0"
                                                                 Fill="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource Brush.Subtle}" CornerRadius="8"
                                                            Padding="6,1" VerticalAlignment="Center" Margin="6,0">
                                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="▶"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="▼"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ToggleButton>
                                            
                                            <!-- Group items (visible when expanded) -->
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="16,0,0,3" Padding="8,4" CornerRadius="3"
                                                                BorderThickness="0,0,0,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Pane}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Subtle}"/>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <DockPanel LastChildFill="True">
                                                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Top" Margin="0,2,5,0"
                                                                             Fill="{Binding SeverityColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    <TextBox Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="10"
                                                                             Style="{StaticResource SelectableText}"
                                                                             TextWrapping="Wrap"/>
                                                                </DockPanel>
                                                                <TextBox Text="{Binding Description, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}"
                                                                         TextWrapping="Wrap" Margin="12,1,0,0" MaxHeight="48"
                                                                         Style="{StaticResource SelectableText}"
                                                                         ToolTip="{Binding Description}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
                <!-- Filter / Query Builder -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🔎 Filter Columns" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding FilterableMetrics}" 
                                      SelectedItem="{Binding FilterColumn}"
                                      Width="100" Margin="0,0,4,0" FontSize="11"/>
                            <ComboBox SelectedValue="{Binding FilterOperator}" SelectedValuePath="Content" Width="45" Margin="0,0,4,0" FontSize="11">
                                <ComboBoxItem Content="&gt;"/>
                                <ComboBoxItem Content="&lt;"/>
                                <ComboBoxItem Content="="/>
                                <ComboBoxItem Content="&gt;="/>
                                <ComboBoxItem Content="&lt;="/>
                            </ComboBox>
                            <TextBox Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="55" Margin="0,0,4,0" FontSize="11"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="Go" Command="{Binding ApplyFilterCommand}" 
                                    Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="✕" Command="{Binding ClearFilterCommand}" 
                                    Padding="6,2" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Column Profiles Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Header with toggle -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding ToggleColumnProfilesExpandedCommand}"
                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                    Cursor="Hand" Padding="0">
                                <TextBlock FontWeight="Bold" FontSize="13">
                                    <Run Text="📊 Column Profiles"/>
                                    <Run Text="{Binding DisplayedColumns.Count, StringFormat='({0})', Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </TextBlock>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding ToggleColumnProfilesExpandedCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.AccentText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsColumnProfilesExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▼"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <!-- Table content (collapsible) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsColumnProfilesExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Horizontal + Vertical scrollable table -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel MinWidth="778">
                                    <!-- Table header (sortable columns) -->
                                    <Border Background="{DynamicResource Brush.Subtle}" BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="1" CornerRadius="4,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="160" MinWidth="80" MaxWidth="160"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Sortable header buttons with toggle direction logic -->
                                            <Button Grid.Column="0" Command="{Binding SetSortCommand}" CommandParameter="Name ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="6,5" HorizontalContentAlignment="Left">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}">
                                                    <Run Text="COLUMN"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Name, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentText}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="1" Command="{Binding SetSortCommand}" CommandParameter="Type ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="3,5" HorizontalContentAlignment="Left">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}">
                                                    <Run Text="TYPE"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Type, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentText}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="2" Command="{Binding SetSortCommand}" CommandParameter="Score ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="2,5" HorizontalContentAlignment="Center">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}">
                                                    <Run Text="SCR"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Score, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentText}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="3" Command="{Binding SetSortCommand}" CommandParameter="Completeness ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="0,5" HorizontalContentAlignment="Center"
                                                    ToolTip="Completeness">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}">
                                                    <Run Text="C"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Completeness, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="4" Command="{Binding SetSortCommand}" CommandParameter="Uniqueness ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="0,5" HorizontalContentAlignment="Center"
                                                    ToolTip="Uniqueness">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Info}">
                                                    <Run Text="U"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Uniqueness, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="5" Command="{Binding SetSortCommand}" CommandParameter="Validity ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="0,5" HorizontalContentAlignment="Center"
                                                    ToolTip="Validity">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}">
                                                    <Run Text="V"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Validity, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="6" Command="{Binding SetSortCommand}" CommandParameter="Distribution ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="0,5" HorizontalContentAlignment="Center"
                                                    ToolTip="Distribution">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Special}">
                                                    <Run Text="D"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Distribution, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="7" Command="{Binding SetSortCommand}" CommandParameter="Nulls ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="2,5" HorizontalContentAlignment="Left">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}">
                                                    <Run Text="NULLS"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Nulls, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentText}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="8" Command="{Binding SetSortCommand}" CommandParameter="Distinct ↑"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="2,5" HorizontalContentAlignment="Left"
                                                    ToolTip="Distinct values">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}">
                                                    <Run Text="DIST"/><Run Text="{Binding ColumnSortBy, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Distinct, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentText}"/>
                                                </TextBlock>
                                            </Button>
                                            
                                            <TextBlock Grid.Column="9" Text="MIN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Padding="3,5"/>
                                            <TextBlock Grid.Column="10" Text="MAX" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Padding="3,5"/>
                                            <TextBlock Grid.Column="11" Text="MEAN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Padding="3,5"/>
                                            <TextBlock Grid.Column="12" Text="DISTRIBUTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Padding="3,5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Table rows -->
                                    <Border BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4">
                                        <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DisplayedColumns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Brush.Subtle}" BorderThickness="0,0,0,1" Padding="0,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Pane}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.ToolTip>
                                                                <StackPanel MaxWidth="240">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="Type: "/><Run Text="{Binding DuckDbType, Mode=OneWay}"/>
                                                                        <Run Text="  ·  "/><Run Text="{Binding Category, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="Completeness: "/><Run Text="{Binding Completeness, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="11" Text="{Binding Median, StringFormat='Median: {0:G6}', TargetNullValue=''}"/>
                                                                    <TextBlock FontSize="11" Text="{Binding StdDev, StringFormat='StdDev: {0:G6}', TargetNullValue=''}"/>
                                                                    <TextBlock FontSize="11" Text="{Binding Q1, StringFormat='Q1: {0:G6}', TargetNullValue=''}"/>
                                                                    <TextBlock FontSize="11" Text="{Binding Q3, StringFormat='Q3: {0:G6}', TargetNullValue=''}"/>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="Outliers: "/><Run Text="{Binding OutlierPercentage, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border.ToolTip>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="64"/>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="48"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="160" MinWidth="80" MaxWidth="160"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Column name -->
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                                           Padding="6,2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                                <!-- Type -->
                                                                <TextBlock Grid.Column="1" Text="{Binding DuckDbType}" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}"
                                                                           Padding="3,2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                                <!-- Score badge -->
                                                                <Border Grid.Column="2" CornerRadius="8" Padding="3,1" Margin="1"
                                                                        Background="{Binding Score.BadgeBackground, Converter={StaticResource StringToBrushConverter}}"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Score.Total, StringFormat={}{0:F0}}" FontSize="9" FontWeight="Bold"
                                                                               Foreground="{Binding Score.BadgeForeground, Converter={StaticResource StringToBrushConverter}}"
                                                                               HorizontalAlignment="Center"/>
                                                                </Border>

                                                                <!-- C U V D dimension scores -->
                                                                <TextBlock Grid.Column="3" Text="{Binding Score.Completeness, StringFormat={}{0:F0}}"
                                                                           FontSize="8" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding Score.Uniqueness, StringFormat={}{0:F0}}"
                                                                           FontSize="8" Foreground="{DynamicResource Brush.Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="5" Text="{Binding Score.Validity, StringFormat={}{0:F0}}"
                                                                           FontSize="8" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="6" Text="{Binding Score.Distribution, StringFormat={}{0:F0}}"
                                                                           FontSize="8" Foreground="{DynamicResource Brush.Special}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                                <!-- Nulls -->
                                                                <TextBlock Grid.Column="7" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" Padding="2,2" VerticalAlignment="Center">
                                                                    <Run Text="{Binding NullPercentage, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                                </TextBlock>

                                                                <!-- Distinct -->
                                                                <TextBlock Grid.Column="8" Text="{Binding DistinctCount, StringFormat={}{0:N0}}"
                                                                           FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" Padding="2,2" VerticalAlignment="Center"/>

                                                                <!-- Min -->
                                                                <TextBlock Grid.Column="9" Text="{Binding DisplayMin}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}"
                                                                           Padding="3,2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           ToolTip="{Binding DisplayMin}"/>

                                                                <!-- Max -->
                                                                <TextBlock Grid.Column="10" Text="{Binding DisplayMax}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}"
                                                                           Padding="3,2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           ToolTip="{Binding DisplayMax}"/>

                                                                <!-- Mean -->
                                                                <TextBlock Grid.Column="11" Text="{Binding DisplayMean}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}"
                                                                           Padding="3,2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           ToolTip="{Binding DisplayMean}"/>

                                                                <!-- Distribution: frequency rows (label | bar | %) -->
                                                                <ItemsControl Grid.Column="12" ItemsSource="{Binding TopValues}"
                                                                              Margin="3,2,3,2" VerticalAlignment="Center">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,0,0,1">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="46"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="26"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding Value}"
                                                                                           FontSize="8" Foreground="{DynamicResource Brush.TextSecondary}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center"
                                                                                           HorizontalAlignment="Right"
                                                                                           Margin="0,0,3,0"
                                                                                           ToolTip="{Binding Value}"/>
                                                                                <ProgressBar Grid.Column="1" Value="{Binding RelativeWidth}" Maximum="100"
                                                                                             Height="5" VerticalAlignment="Center"
                                                                                             Background="{DynamicResource Brush.Subtle}" Foreground="{DynamicResource Brush.AccentHover}"
                                                                                             BorderThickness="0"/>
                                                                                <TextBlock Grid.Column="2" FontSize="8" Foreground="{DynamicResource Brush.TextMuted}"
                                                                                           VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Run Text="{Binding Percentage, StringFormat={}{0:F0}, Mode=OneWay}"/><Run Text="%"/>
                                                                                </TextBlock>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Dimension Group-By Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Toggle header -->
                        <Button Command="{Binding ToggleGroupByExpandedCommand}" 
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                Cursor="Hand" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📐 Group By Dimensions" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶ Expand"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroupByExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▼ Collapse"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                        
                        <!-- Expandable dimension picker -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGroupByExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="Select categorical columns to group by:" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            
                            <ItemsControl ItemsSource="{Binding AvailableDimensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  FontSize="11" Margin="0,0,10,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="▶ Apply Group By" Command="{Binding ApplyGroupByCommand}"
                                        Padding="10,4" FontSize="11" HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.OnAccent}" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="✕ Clear" Command="{Binding ClearGroupByCommand}"
                                        Padding="10,4" FontSize="11" Margin="8,0,0,0"
                                        Background="Transparent" Foreground="{DynamicResource Brush.TextMuted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Cursor="Hand"/>
                            </StackPanel>
                            
                            <!-- Status message -->
                            <TextBlock Text="{Binding GroupByStatusMessage}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <!-- Grouped Results (always visible when available, even when collapsed) -->
                        <TextBlock Text="{Binding GroupedResultsSummary}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasGroupedResults, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding GroupedResults}" Margin="0,8,0,0"
                                      Visibility="{Binding HasGroupedResults, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Pane}" BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding GroupKey}" FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" 
                                                       VerticalAlignment="Center" Margin="8,0">
                                                <Run Text="{Binding RowCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                <Run Text="rows"/>
                                            </TextBlock>
                                            <Border Grid.Column="2" CornerRadius="10" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold"
                                                           Text="{Binding QualityScore, StringFormat={}{0:F0}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Load More Groups"
                                Command="{Binding LoadMoreGroupedResultsCommand}"
                                Padding="10,4" FontSize="11" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Background="Transparent" Foreground="{DynamicResource Brush.HeadingText}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Cursor="Hand"
                                Visibility="{Binding CanLoadMoreGroupedResults, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                
                <!-- File Comparison Section -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🔄 File Comparison" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        
                        <Button Content="Compare with another file..." 
                                Command="{Binding CompareWithFileCommand}"
                                Padding="10,4" FontSize="11" HorizontalAlignment="Left"/>
                        
                        <!-- Comparison results -->
                        <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}"
                                    Margin="0,8,0,0">
                            <TextBlock FontSize="11" Margin="0,0,0,4">
                                <Run Text="Comparing with: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Run Text="{Binding ComparisonFileName, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Baseline" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding Comparison.BaselineProfile.RowCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        <Run Text=" rows"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11">
                                        <Run Text="Score: "/>
                                        <Run Text="{Binding Comparison.BaselineProfile.OverallScore.Total, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Comparison" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding Comparison.ComparisonProfile.RowCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        <Run Text=" rows"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11">
                                        <Run Text="Score: "/>
                                        <Run Text="{Binding Comparison.ComparisonProfile.OverallScore.Total, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            
                            <TextBlock FontSize="11" Margin="0,6,0,0">
                                <Run Text="Row delta: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Run Text="{Binding Comparison.RowCountDelta, StringFormat={}{0:+#,0;-#,0;0}, Mode=OneWay}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding Comparison.RowCountDeltaPercent, StringFormat={}{0:+0.0;-0.0;0.0}%, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            
                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                <Run Text="Schema changes: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Run Text="{Binding Comparison.SchemaChanges.Count, Mode=OneWay}"/>
                            </TextBlock>
                            
                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                <Run Text="Drift score: " Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Run Text="{Binding Comparison.DriftScore, StringFormat={}{0:F1}/100, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Schema Diff Table -->
                            <Expander Header="📊 Schema Diff" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold"
                                      Visibility="{Binding HasSchemaDiff, Converter={StaticResource BoolToVis}}"
                                      IsExpanded="True">
                                <Border BorderBrush="{DynamicResource Brush.BorderNeutral}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Header row -->
                                        <Grid Background="{DynamicResource Brush.Subtle}" Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="" FontSize="10" FontWeight="Bold" Padding="4,3"/>
                                            <TextBlock Grid.Column="1" Text="Column" FontSize="10" FontWeight="Bold" Padding="4,3"/>
                                            <TextBlock Grid.Column="2" Text="Baseline" FontSize="10" FontWeight="Bold" Padding="4,3" Foreground="{DynamicResource Brush.InfoText}"/>
                                            <TextBlock Grid.Column="3" Text="Compare" FontSize="10" FontWeight="Bold" Padding="4,3" Foreground="{DynamicResource Brush.SpecialText}"/>
                                        </Grid>
                                        <!-- Diff rows -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SchemaDiffItems}" MaxHeight="200">
                                            <ItemsControl.Template>
                                                <ControlTemplate>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter/>
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" 
                                                                   FontWeight="Bold" FontSize="12" Padding="6,2"
                                                                   Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ColumnName}" 
                                                                   FontSize="10" Padding="4,2" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ColumnName}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding BaselineType}" 
                                                                   FontSize="10" Padding="4,2" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ComparisonType}" 
                                                                   FontSize="10" Padding="4,2" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
